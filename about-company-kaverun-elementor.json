{"content":[{"id":"kvab0001","elType":"container","settings":{"content_width":"full","flex_gap":{"unit":"px","size":0,"column":"0","row":"0"},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"kvab0002","elType":"widget","widgetType":"html","settings":{"html":"<!--\n============================================================================\n  KAVERUN — «معرفی گروه صنعتی کاوران» | صفحه‌ی کامل درباره ما (سئو + مارکتینگ)\n  ---------------------------------------------------------------------------\n  • یک فایل کاملاً مستقل و بدون هیچ وابستگی خارجی (CDN / فونت / jQuery / GSAP).\n    یک بلوک «Custom HTML» در وردپرس بسازید و کل این فایل را داخل آن Paste کنید.\n  • برای صفحه‌ی /about طراحی شده و شامل: هیرو، تاریخچه، آمار متحرک، ارزش‌ها،\n    چشم‌انداز و ماموریت، شبکه‌ی محصولات (لینک‌سازی داخلی) و بخش تماس + پرسش‌های\n    متداول با ریزداده‌ی FAQ برای ریچ‌اسنیپت گوگل.\n  • سئو: یک <h1> واحد، سلسله‌مراتب هدینگ منطقی، ریزداده‌ی Organization +\n    BreadcrumbList + FAQPage، متن کلیدواژه‌محور و لینک‌سازی داخلی به محصولات.\n  • Core Web Vitals: بدون layout shift، انیمیشن‌های GPU-محور (transform/opacity)،\n    اسکریپت سبک با IntersectionObserver و پشتیبانی prefers-reduced-motion.\n============================================================================\n-->\n<section\n  id=\"kv-about\"\n  class=\"kv-about\"\n  dir=\"rtl\"\n  lang=\"fa\"\n  itemscope\n  itemtype=\"https://schema.org/Organization\"\n  aria-labelledby=\"kv-about-title\"\n>\n  <!-- ریزداده‌ی سازمان (نامرئی، فقط برای موتور جست‌وجو) -->\n  <meta itemprop=\"name\" content=\"گروه صنعتی کاوران (Kaverun)\" />\n  <meta itemprop=\"alternateName\" content=\"شرکت چلنگر\" />\n  <meta itemprop=\"foundingDate\" content=\"2006\" />\n  <meta itemprop=\"url\" content=\"https://kaverun.com/\" />\n  <meta itemprop=\"slogan\" content=\"تولید ماشین‌آلات راه‌سازی، ساختمانی و کشاورزی\" />\n  <link itemprop=\"logo\" href=\"https://kaverun.com/wp-content/uploads/2024/01/99.webp\" />\n  <div itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\" hidden>\n    <meta itemprop=\"addressLocality\" content=\"شهر صنعتی کاوه\" />\n    <meta itemprop=\"addressRegion\" content=\"مرکزی\" />\n    <meta itemprop=\"addressCountry\" content=\"IR\" />\n  </div>\n\n  <div class=\"kv-about__wrap\">\n\n    <!-- ================= HERO / معرفی ================= -->\n    <header class=\"kv-about__hero\">\n      <nav class=\"kv-about__crumb\" aria-label=\"مسیر\" itemscope itemtype=\"https://schema.org/BreadcrumbList\">\n        <span itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\">\n          <a itemprop=\"item\" href=\"https://kaverun.com/\"><span itemprop=\"name\">خانه</span></a>\n          <meta itemprop=\"position\" content=\"1\" />\n        </span>\n        <span class=\"kv-about__crumb-sep\" aria-hidden=\"true\">›</span>\n        <span itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/ListItem\">\n          <span itemprop=\"name\" aria-current=\"page\">درباره ما</span>\n          <meta itemprop=\"position\" content=\"2\" />\n        </span>\n      </nav>\n\n      <p class=\"kv-about__eyebrow\" data-kv-reveal>\n        <span class=\"kv-about__dot\" aria-hidden=\"true\"></span>\n        از سال ۱۳۸۵ در شهر صنعتی کاوه\n      </p>\n\n      <h1 id=\"kv-about-title\" class=\"kv-about__title\" data-kv-reveal>\n        گروه صنعتی <span class=\"kv-about__brand\">کاوران</span>؛\n        تولیدکننده‌ی ماشین‌آلات راه‌سازی، ساختمانی و کشاورزی\n      </h1>\n\n      <p class=\"kv-about__lede\" data-kv-reveal>\n        <strong>کاوران (Kaverun)</strong> با نام تجاری برخاسته از\n        <strong>شرکت چلنگر</strong>، سازنده‌ی انواع\n        <strong>بیل مکانیکی</strong>، <strong>مینی‌بیل</strong>،\n        <strong>لودر</strong>، <strong>اسکیدلودر</strong> و\n        <strong>لیفتراک</strong> است؛ ماشین‌آلاتی که با تکیه بر دانش فنی\n        مهندسان داخلی و تکنولوژی روز، برای بازار داخلی و صادرات تولید می‌شوند.\n      </p>\n\n      <div class=\"kv-about__cta\" data-kv-reveal>\n        <a class=\"kv-about__btn kv-about__btn--primary\" href=\"#kv-about-products\">\n          مشاهده محصولات\n          <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 6l-6 6 6 6\"/></svg>\n        </a>\n        <a class=\"kv-about__btn kv-about__btn--ghost\" href=\"/contact\"\n           aria-label=\"تماس با کارشناسان فروش گروه صنعتی کاوران\">\n          دریافت مشاوره و قیمت\n        </a>\n      </div>\n    </header>\n\n    <!-- ================= آمار متحرک ================= -->\n    <section class=\"kv-about__stats\" aria-label=\"کاوران در یک نگاه\" data-kv-reveal>\n      <div class=\"kv-stat\">\n        <div class=\"kv-stat__num\"><span class=\"kv-count\" data-to=\"1000\" data-suffix=\"+\">۱۰۰۰+</span></div>\n        <div class=\"kv-stat__label\">ظرفیت تولید در سال (دستگاه)</div>\n      </div>\n      <div class=\"kv-stat\">\n        <div class=\"kv-stat__num\"><span class=\"kv-count\" data-to=\"65\" data-suffix=\"+\">۶۵+</span></div>\n        <div class=\"kv-stat__label\">نیروی متخصص و پرسنل</div>\n      </div>\n      <div class=\"kv-stat\">\n        <div class=\"kv-stat__num\"><span class=\"kv-count\" data-to=\"21\" data-suffix=\"+\">۲۱+</span></div>\n        <div class=\"kv-stat__label\">سال سابقه‌ی تولید</div>\n      </div>\n      <div class=\"kv-stat\">\n        <div class=\"kv-stat__num\"><span class=\"kv-count\" data-to=\"10150\" data-suffix=\" m²\">۱۰۱۵۰ m²</span></div>\n        <div class=\"kv-stat__label\">وسعت مجموعه‌ی تولیدی</div>\n      </div>\n    </section>\n\n    <!-- ================= داستان / تاریخچه ================= -->\n    <section class=\"kv-about__section\" aria-labelledby=\"kv-about-story\">\n      <div class=\"kv-about__col-head\" data-kv-reveal>\n        <span class=\"kv-about__kicker\">مسیر ما</span>\n        <h2 id=\"kv-about-story\" class=\"kv-about__h2\">از تولید لوله و پروفیل تا ماشین‌آلات سنگین</h2>\n      </div>\n\n      <ol class=\"kv-timeline\">\n        <li class=\"kv-timeline__item\" data-kv-reveal>\n          <span class=\"kv-timeline__year\">۱۳۸۵</span>\n          <div class=\"kv-timeline__body\">\n            <h3 class=\"kv-timeline__title\">آغاز فعالیت</h3>\n            <p>\n              گروه صنعتی کاوران (شرکت چلنگر) فعالیت خود را در زمینی به وسعت\n              <strong>۱۰٬۱۵۰ مترمربع</strong> با تولید انواع\n              <strong>لوله و پروفیل</strong> صنعتی آغاز کرد و پایه‌های زیرساخت\n              تولیدی خود را بنا نهاد.\n            </p>\n          </div>\n        </li>\n        <li class=\"kv-timeline__item\" data-kv-reveal>\n          <span class=\"kv-timeline__year\">۱۳۹۸</span>\n          <div class=\"kv-timeline__body\">\n            <h3 class=\"kv-timeline__title\">توسعه به ماشین‌آلات سنگین</h3>\n            <p>\n              با بهره‌گیری از کارشناسان باتجربه و تکنسین‌های آشنا به تکنولوژی روز،\n              خط تولید به <strong>بیل مکانیکی</strong>، <strong>لودر</strong> و\n              <strong>بابکت (اسکیدلودر)</strong> گسترش یافت و کاوران وارد صنعت\n              ماشین‌آلات <strong>راه‌سازی، ساختمانی و کشاورزی</strong> شد.\n            </p>\n          </div>\n        </li>\n        <li class=\"kv-timeline__item\" data-kv-reveal>\n          <span class=\"kv-timeline__year\">امروز</span>\n          <div class=\"kv-timeline__body\">\n            <h3 class=\"kv-timeline__title\">تولید و صادرات</h3>\n            <p>\n              کاوران با مدرن‌سازی مستمر ماشین‌آلات و تجهیزات خود، سبد کاملی از\n              <a class=\"kv-about__inline\" href=\"#kv-about-products\">ماشین‌آلات کاوران</a>\n              را با تأکید بر <strong>کیفیت، تحویل به‌موقع و خدمات پس از فروش</strong>\n              به بازار داخلی و بازارهای صادراتی عرضه می‌کند.\n            </p>\n          </div>\n        </li>\n      </ol>\n    </section>\n\n    <!-- ================= ارزش‌ها / افتخارات ================= -->\n    <section class=\"kv-about__section\" aria-labelledby=\"kv-about-values\">\n      <div class=\"kv-about__col-head\" data-kv-reveal>\n        <span class=\"kv-about__kicker\">چرا کاوران</span>\n        <h2 id=\"kv-about-values\" class=\"kv-about__h2\">ارزش‌ها و افتخارات ما</h2>\n        <p class=\"kv-about__sub\">\n          تعهد به نوآوری، تنوع تولیدات و تحویل به‌موقع، ستون‌های اعتماد مشتریان\n          کاوران در داخل و خارج از کشور است.\n        </p>\n      </div>\n\n      <div class=\"kv-cards\">\n        <article class=\"kv-card\" data-kv-reveal>\n          <span class=\"kv-card__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"26\" height=\"26\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12l2 2 4-4\"/></svg>\n          </span>\n          <h3 class=\"kv-card__title\">تعهد و مسئولیت‌پذیری</h3>\n          <p class=\"kv-card__desc\">\n            بهترین کیفیت، بیشترین دقت و بالاترین تجربه با قیمت رقابتی؛ همراه با\n            بهبود مستمر کیفیت و تمرکز بر رضایت مشتری.\n          </p>\n        </article>\n\n        <article class=\"kv-card\" data-kv-reveal>\n          <span class=\"kv-card__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"26\" height=\"26\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 3l2.5 5 5.5.8-4 3.9.9 5.5L12 21l-4.9 2.6.9-5.5-4-3.9 5.5-.8L12 3z\"/></svg>\n          </span>\n          <h3 class=\"kv-card__title\">برندی مشهور و قابل اعتماد</h3>\n          <p class=\"kv-card__desc\">\n            نامی شناخته‌شده در داخل و خارج از مرزهای ایران، با شهرت در کیفیت و\n            مرغوبیت کالا و وفاداری به مشتریان.\n          </p>\n        </article>\n\n        <article class=\"kv-card\" data-kv-reveal>\n          <span class=\"kv-card__icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"26\" height=\"26\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 15a4 4 0 100-8 4 4 0 000 8z\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 14l-2 7 5-3 5 3-2-7\"/></svg>\n          </span>\n          <h3 class=\"kv-card__title\">معتبر و باسابقه</h3>\n          <p class=\"kv-card__desc\">\n            دارای مجوزهای لازم از سازمان‌های مربوطه و بهره‌مند از بیش از ۲۰ سال\n            سابقه‌ی درخشان در تولید و خدمات پس از فروش.\n          </p>\n        </article>\n      </div>\n    </section>\n\n    <!-- ================= چشم‌انداز و ماموریت ================= -->\n    <section class=\"kv-about__section\" aria-labelledby=\"kv-about-vision\">\n      <h2 id=\"kv-about-vision\" class=\"kv-about__h2 kv-sr-only\">چشم‌انداز و ماموریت</h2>\n      <div class=\"kv-vm\">\n        <article class=\"kv-vm__card kv-vm__card--vision\" data-kv-reveal>\n          <span class=\"kv-vm__tag\">چشم‌انداز</span>\n          <h3 class=\"kv-vm__title\">حضور پررنگ‌تر در بازار داخلی و جهانی</h3>\n          <p class=\"kv-vm__text\">\n            کاوران با ارائه‌ی محصولات باکیفیت و قیمت رقابتی می‌کوشد سهم بیشتری از\n            بازار داخلی و جهانی به‌دست آورد، شبکه‌ی توزیع و پشتیبانی جهانی بسازد و\n            با تحقیق و توسعه‌ی مستمر، بازار صادرات ماشین‌آلات خود را گسترش دهد.\n          </p>\n        </article>\n\n        <article class=\"kv-vm__card kv-vm__card--mission\" data-kv-reveal>\n          <span class=\"kv-vm__tag\">بیانیه‌ی ماموریت</span>\n          <h3 class=\"kv-vm__title\">پیشگام تولید ماشین‌آلات داخلی</h3>\n          <p class=\"kv-vm__text\">\n            ماموریت کاوران، تولید ماشین‌آلات راه‌سازی، ساختمانی و کشاورزی با\n            بهره‌گیری از تکنولوژی پیشرفته و دانش فنی مهندسان داخلی است؛ برای جلب\n            رضایت مشتریان، ارتقای صنعت و اقتصاد کشور، حفظ محیط زیست و توسعه‌ی صادرات.\n          </p>\n        </article>\n      </div>\n    </section>\n\n    <!-- ================= محصولات (لینک‌سازی داخلی) ================= -->\n    <section id=\"kv-about-products\" class=\"kv-about__section\" aria-labelledby=\"kv-about-products-h\"\n             itemscope itemtype=\"https://schema.org/ItemList\">\n      <meta itemprop=\"name\" content=\"محصولات گروه صنعتی کاوران\" />\n      <div class=\"kv-about__col-head\" data-kv-reveal>\n        <span class=\"kv-about__kicker\">سبد محصولات</span>\n        <h2 id=\"kv-about-products-h\" class=\"kv-about__h2\">ماشین‌آلات تولیدی کاوران</h2>\n        <p class=\"kv-about__sub\">\n          از مینی‌بیل چابک تا لودر سنگین معدنی؛ روی هر محصول بزنید تا مشخصات فنی و\n          مشاوره‌ی خرید را ببینید.\n        </p>\n      </div>\n\n      <div class=\"kv-prods\">\n        <a class=\"kv-prod\" href=\"https://kaverun.com/mini-excavator\" data-kv-reveal\n           itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/Product\">\n          <meta itemprop=\"position\" content=\"1\" />\n          <span class=\"kv-prod__badge\">مینی‌بیل</span>\n          <h3 class=\"kv-prod__name\" itemprop=\"name\">مینی بیل مکانیکی کاوران</h3>\n          <p class=\"kv-prod__desc\" itemprop=\"description\">بیل چرخ‌زنجیری جمع‌وجور برای فضاهای محدود و پروژه‌های سبک.</p>\n          <span class=\"kv-prod__more\">مشاهده محصول ‹</span>\n          <meta itemprop=\"url\" content=\"https://kaverun.com/mini-excavator\" />\n        </a>\n\n        <a class=\"kv-prod\" href=\"https://kaverun.com/excavator-8-5-ton\" data-kv-reveal\n           itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/Product\">\n          <meta itemprop=\"position\" content=\"2\" />\n          <span class=\"kv-prod__badge\">بیل مکانیکی</span>\n          <h3 class=\"kv-prod__name\" itemprop=\"name\">بیل مکانیکی ۸.۵ تن کاوران</h3>\n          <p class=\"kv-prod__desc\" itemprop=\"description\">بیل مکانیکی چرخ‌زنجیری راه‌سازی برای عملیات خاک‌برداری سنگین.</p>\n          <span class=\"kv-prod__more\">مشاهده محصول ‹</span>\n          <meta itemprop=\"url\" content=\"https://kaverun.com/excavator-8-5-ton\" />\n        </a>\n\n        <a class=\"kv-prod\" href=\"https://kaverun.com/loader-2-5-ton\" data-kv-reveal\n           itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/Product\">\n          <meta itemprop=\"position\" content=\"3\" />\n          <span class=\"kv-prod__badge\">لودر</span>\n          <h3 class=\"kv-prod__name\" itemprop=\"name\">لودر ۲.۵ تن کاوران</h3>\n          <p class=\"kv-prod__desc\" itemprop=\"description\">لودر چرخ‌لاستیکی جمع‌وجور و مقرون‌به‌صرفه برای بارگیری روزانه.</p>\n          <span class=\"kv-prod__more\">مشاهده محصول ‹</span>\n          <meta itemprop=\"url\" content=\"https://kaverun.com/loader-2-5-ton\" />\n        </a>\n\n        <a class=\"kv-prod\" href=\"https://kaverun.com/loader-5-5-ton\" data-kv-reveal\n           itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/Product\">\n          <meta itemprop=\"position\" content=\"4\" />\n          <span class=\"kv-prod__badge\">لودر سنگین</span>\n          <h3 class=\"kv-prod__name\" itemprop=\"name\">لودر ۵.۵ تن کاوران</h3>\n          <p class=\"kv-prod__desc\" itemprop=\"description\">لودر چرخ‌لاستیکی سنگین معدنی برای کارهای پرحجم و پیوسته.</p>\n          <span class=\"kv-prod__more\">مشاهده محصول ‹</span>\n          <meta itemprop=\"url\" content=\"https://kaverun.com/loader-5-5-ton\" />\n        </a>\n\n        <a class=\"kv-prod\" href=\"https://kaverun.com/skid-loader\" data-kv-reveal\n           itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/Product\">\n          <meta itemprop=\"position\" content=\"5\" />\n          <span class=\"kv-prod__badge\">اسکیدلودر</span>\n          <h3 class=\"kv-prod__name\" itemprop=\"name\">اسکیدلودر کاوران (ERS65)</h3>\n          <p class=\"kv-prod__desc\" itemprop=\"description\">لودر اسکید فرمان‌پذیر و همه‌کاره برای فضاهای تنگ و کاربری متنوع.</p>\n          <span class=\"kv-prod__more\">مشاهده محصول ‹</span>\n          <meta itemprop=\"url\" content=\"https://kaverun.com/skid-loader\" />\n        </a>\n\n        <a class=\"kv-prod\" href=\"https://kaverun.com/forklift\" data-kv-reveal\n           itemprop=\"itemListElement\" itemscope itemtype=\"https://schema.org/Product\">\n          <meta itemprop=\"position\" content=\"6\" />\n          <span class=\"kv-prod__badge\">لیفتراک</span>\n          <h3 class=\"kv-prod__name\" itemprop=\"name\">لیفتراک کاوران</h3>\n          <p class=\"kv-prod__desc\" itemprop=\"description\">لیفتراک صنعتی برای جابه‌جایی مطمئن بار در انبار و خط تولید.</p>\n          <span class=\"kv-prod__more\">مشاهده محصول ‹</span>\n          <meta itemprop=\"url\" content=\"https://kaverun.com/forklift\" />\n        </a>\n      </div>\n    </section>\n\n    <!-- ================= پرسش‌های متداول (FAQ schema) ================= -->\n    <section class=\"kv-about__section\" aria-labelledby=\"kv-about-faq\"\n             itemscope itemtype=\"https://schema.org/FAQPage\">\n      <div class=\"kv-about__col-head\" data-kv-reveal>\n        <span class=\"kv-about__kicker\">پرسش‌های متداول</span>\n        <h2 id=\"kv-about-faq\" class=\"kv-about__h2\">سؤال‌های پرتکرار درباره‌ی کاوران</h2>\n      </div>\n\n      <div class=\"kv-faq\">\n        <details class=\"kv-faq__item\" data-kv-reveal\n                 itemscope itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\n          <summary itemprop=\"name\">گروه صنعتی کاوران چه محصولاتی تولید می‌کند؟</summary>\n          <div class=\"kv-faq__ans\" itemscope itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\n            <p itemprop=\"text\">\n              کاوران تولیدکننده‌ی انواع بیل مکانیکی، مینی‌بیل، لودر چرخ‌لاستیکی،\n              اسکیدلودر (بابکت) و لیفتراک برای کاربردهای راه‌سازی، ساختمانی و\n              کشاورزی است.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"kv-faq__item\" data-kv-reveal\n                 itemscope itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\n          <summary itemprop=\"name\">کارخانه‌ی کاوران کجاست و از چه سالی فعال است؟</summary>\n          <div class=\"kv-faq__ans\" itemscope itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\n            <p itemprop=\"text\">\n              مجموعه‌ی تولیدی کاوران در شهر صنعتی کاوه و در زمینی به وسعت ۱۰٬۱۵۰\n              مترمربع مستقر است و از سال ۱۳۸۵ فعالیت خود را آغاز کرده است.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"kv-faq__item\" data-kv-reveal\n                 itemscope itemprop=\"mainEntity\" itemtype=\"https://schema.org/Question\">\n          <summary itemprop=\"name\">برای خرید و مشاوره‌ی فنی چگونه اقدام کنم؟</summary>\n          <div class=\"kv-faq__ans\" itemscope itemprop=\"acceptedAnswer\" itemtype=\"https://schema.org/Answer\">\n            <p itemprop=\"text\">\n              کافی است از طریق صفحه‌ی\n              <a class=\"kv-about__inline\" href=\"/contact\">تماس با ما</a>\n              با کارشناسان فروش کاوران در ارتباط باشید تا مشاوره‌ی فنی، قیمت و\n              شرایط تحویل را دریافت کنید.\n            </p>\n          </div>\n        </details>\n      </div>\n    </section>\n\n    <!-- ================= CTA پایانی ================= -->\n    <aside class=\"kv-about__final\" data-kv-reveal>\n      <div class=\"kv-about__final-inner\">\n        <h2 class=\"kv-about__final-title\">آماده‌ی همکاری با شما هستیم</h2>\n        <p class=\"kv-about__final-text\">\n          برای انتخاب مناسب‌ترین ماشین‌آلات راه‌سازی، ساختمانی و کشاورزی، با\n          کارشناسان گروه صنعتی کاوران گفت‌وگو کنید.\n        </p>\n        <div class=\"kv-about__cta\">\n          <a class=\"kv-about__btn kv-about__btn--primary\" href=\"/contact\"\n             aria-label=\"تماس با گروه صنعتی کاوران\">\n            تماس با ما\n            <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 6l-6 6 6 6\"/></svg>\n          </a>\n          <a class=\"kv-about__btn kv-about__btn--ghost\" href=\"#kv-about-products\">\n            بازگشت به محصولات\n          </a>\n        </div>\n      </div>\n    </aside>\n\n  </div>\n</section>\n\n<style id=\"kv-about-styles\">\n#kv-about, #kv-about *, #kv-about *::before, #kv-about *::after { box-sizing: border-box; }\n\n#kv-about {\n  --kv-bg: #0b0c10;\n  --kv-bg-2: #101218;\n  --kv-fg: #ffffff;\n  --kv-muted: rgba(255,255,255,.72);\n  --kv-faint: rgba(255,255,255,.55);\n  --kv-accent: #FFC72C;\n  --kv-ink: #111111;\n  --kv-line: rgba(255,255,255,.10);\n  --kv-card: rgba(255,255,255,.035);\n  --kv-ease: cubic-bezier(.22,1,.36,1);\n\n  position: relative; width: 100%; margin: 0;\n  padding: clamp(48px, 8vw, 110px) clamp(16px, 5vw, 80px);\n  background:\n    radial-gradient(80% 55% at 50% -8%, rgba(255,199,44,.10) 0%, rgba(255,199,44,0) 55%),\n    var(--kv-bg);\n  color: var(--kv-fg); direction: rtl; font-family: inherit; overflow: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n#kv-about::before {\n  content: \"\"; position: absolute; inset: 0; z-index: 0;\n  background-image: linear-gradient(var(--kv-line) 1px, transparent 1px),\n                    linear-gradient(90deg, var(--kv-line) 1px, transparent 1px);\n  background-size: 46px 46px;\n  -webkit-mask-image: radial-gradient(75% 55% at 50% 0%, #000 0%, transparent 80%);\n          mask-image: radial-gradient(75% 55% at 50% 0%, #000 0%, transparent 80%);\n  opacity: .38; pointer-events: none;\n}\n#kv-about .kv-about__wrap {\n  position: relative; z-index: 1; max-width: 1120px; margin: 0 auto;\n}\n\n/* ---------- Hero ---------- */\n#kv-about .kv-about__hero { text-align: center; max-width: 860px; margin: 0 auto; }\n#kv-about .kv-about__crumb {\n  display: flex; align-items: center; justify-content: center; gap: 8px;\n  margin: 0 0 22px; font-size: 13px; color: var(--kv-faint);\n}\n#kv-about .kv-about__crumb a { color: var(--kv-faint); text-decoration: none; transition: color .2s; }\n#kv-about .kv-about__crumb a:hover { color: var(--kv-accent); }\n#kv-about .kv-about__crumb-sep { color: rgba(255,255,255,.3); }\n\n#kv-about .kv-about__eyebrow {\n  display: inline-flex; align-items: center; gap: 9px; margin: 0 0 20px;\n  padding: 8px 16px; border: 1px solid var(--kv-line); border-radius: 999px;\n  background: rgba(255,255,255,.03);\n  font-size: clamp(12px, 1.2vw, 14px); font-weight: 700; color: var(--kv-accent);\n}\n#kv-about .kv-about__dot {\n  width: 8px; height: 8px; border-radius: 50%; background: var(--kv-accent);\n  animation: kvAbPulse 2.2s ease-out infinite;\n}\n@keyframes kvAbPulse {\n  0% { box-shadow: 0 0 0 0 rgba(255,199,44,.55); }\n  70% { box-shadow: 0 0 0 10px rgba(255,199,44,0); }\n  100% { box-shadow: 0 0 0 0 rgba(255,199,44,0); }\n}\n#kv-about .kv-about__title {\n  margin: 0 0 20px; font-size: clamp(27px, 4.6vw, 50px);\n  line-height: 1.28; font-weight: 800; letter-spacing: -.01em;\n}\n#kv-about .kv-about__brand { color: var(--kv-accent); }\n#kv-about .kv-about__lede {\n  margin: 0 auto; max-width: 680px;\n  font-size: clamp(15px, 1.7vw, 19px); line-height: 2.05; color: var(--kv-muted);\n}\n#kv-about .kv-about__lede strong { color: #fff; font-weight: 700; }\n\n#kv-about .kv-about__cta {\n  display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 32px;\n}\n#kv-about .kv-about__btn {\n  display: inline-flex; align-items: center; gap: 8px;\n  padding: 14px 28px; border-radius: 999px;\n  font-weight: 700; font-size: 15px; text-decoration: none;\n  border: 2px solid transparent; cursor: pointer;\n  transition: transform .18s var(--kv-ease), box-shadow .2s var(--kv-ease), background-color .2s, border-color .2s;\n}\n#kv-about .kv-about__btn svg { transition: transform .2s var(--kv-ease); }\n#kv-about .kv-about__btn--primary { background: var(--kv-accent); color: var(--kv-ink); box-shadow: 0 12px 30px rgba(255,199,44,.30); }\n#kv-about .kv-about__btn--primary:hover { transform: translateY(-2px); box-shadow: 0 16px 38px rgba(255,199,44,.45); }\n#kv-about .kv-about__btn--primary:hover svg { transform: translateX(-4px); }\n#kv-about .kv-about__btn--ghost { background: rgba(255,255,255,.05); color: #fff; border-color: var(--kv-line); }\n#kv-about .kv-about__btn--ghost:hover { border-color: rgba(255,255,255,.5); background: rgba(255,255,255,.1); }\n#kv-about .kv-about__btn:focus-visible { outline: 3px solid var(--kv-accent); outline-offset: 3px; }\n\n/* ---------- Stats ---------- */\n#kv-about .kv-about__stats {\n  display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;\n  margin: clamp(46px, 7vw, 84px) auto 0; max-width: 980px;\n}\n#kv-about .kv-stat {\n  text-align: center; padding: 26px 14px; border-radius: 18px;\n  border: 1px solid var(--kv-line); background: var(--kv-card);\n}\n#kv-about .kv-stat__num {\n  font-size: clamp(26px, 3.4vw, 40px); font-weight: 800; color: var(--kv-accent);\n  line-height: 1.1; font-variant-numeric: tabular-nums;\n}\n#kv-about .kv-stat__label { margin-top: 8px; font-size: clamp(12px, 1.3vw, 14px); color: var(--kv-muted); }\n\n/* ---------- Section shell ---------- */\n#kv-about .kv-about__section { margin-top: clamp(56px, 9vw, 112px); }\n#kv-about .kv-about__col-head { max-width: 720px; margin: 0 auto clamp(30px, 4vw, 48px); text-align: center; }\n#kv-about .kv-about__kicker {\n  display: inline-block; margin-bottom: 12px; padding: 5px 13px; border-radius: 999px;\n  font-size: 12px; font-weight: 700; letter-spacing: .02em;\n  color: var(--kv-accent); background: rgba(255,199,44,.10); border: 1px solid rgba(255,199,44,.25);\n}\n#kv-about .kv-about__h2 {\n  margin: 0; font-size: clamp(23px, 3.4vw, 36px); font-weight: 800; line-height: 1.3; letter-spacing: -.01em;\n}\n#kv-about .kv-about__sub { margin: 14px auto 0; max-width: 620px; font-size: clamp(14px, 1.5vw, 17px); line-height: 1.95; color: var(--kv-muted); }\n#kv-about .kv-about__inline { color: var(--kv-accent); text-decoration: none; border-bottom: 1px solid rgba(255,199,44,.4); }\n#kv-about .kv-about__inline:hover { border-bottom-color: var(--kv-accent); }\n\n/* ---------- Timeline ---------- */\n#kv-about .kv-timeline { list-style: none; margin: 0 auto; padding: 0; max-width: 760px; position: relative; }\n#kv-about .kv-timeline::before {\n  content: \"\"; position: absolute; top: 8px; bottom: 8px; right: 26px; width: 2px;\n  background: linear-gradient(var(--kv-accent), rgba(255,199,44,.15));\n}\n#kv-about .kv-timeline__item { position: relative; display: flex; gap: 20px; padding: 0 0 30px; }\n#kv-about .kv-timeline__item:last-child { padding-bottom: 0; }\n#kv-about .kv-timeline__year {\n  flex: 0 0 auto; width: 54px; height: 54px; border-radius: 50%;\n  display: inline-flex; align-items: center; justify-content: center;\n  background: var(--kv-accent); color: var(--kv-ink);\n  font-size: 13px; font-weight: 800; z-index: 1;\n  box-shadow: 0 0 0 6px var(--kv-bg);\n}\n#kv-about .kv-timeline__body {\n  flex: 1 1 auto; padding: 18px 20px;\n  border: 1px solid var(--kv-line); border-radius: 16px; background: var(--kv-card);\n}\n#kv-about .kv-timeline__title { margin: 0 0 8px; font-size: clamp(16px, 2vw, 20px); font-weight: 700; }\n#kv-about .kv-timeline__body p { margin: 0; font-size: clamp(14px, 1.5vw, 16px); line-height: 1.95; color: var(--kv-muted); }\n#kv-about .kv-timeline__body strong { color: #fff; font-weight: 700; }\n\n/* ---------- Value cards ---------- */\n#kv-about .kv-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }\n#kv-about .kv-card {\n  padding: 30px 26px; border-radius: 20px; border: 1px solid var(--kv-line);\n  background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));\n  transition: transform .25s var(--kv-ease), border-color .25s, box-shadow .25s;\n}\n#kv-about .kv-card:hover { transform: translateY(-4px); border-color: rgba(255,199,44,.4); box-shadow: 0 18px 40px rgba(0,0,0,.35); }\n#kv-about .kv-card__icon {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 54px; height: 54px; border-radius: 14px; margin-bottom: 18px;\n  color: var(--kv-accent); background: rgba(255,199,44,.10); border: 1px solid rgba(255,199,44,.22);\n}\n#kv-about .kv-card__title { margin: 0 0 10px; font-size: clamp(17px, 2vw, 20px); font-weight: 700; }\n#kv-about .kv-card__desc { margin: 0; font-size: clamp(14px, 1.5vw, 16px); line-height: 1.95; color: var(--kv-muted); }\n\n/* ---------- Vision / Mission ---------- */\n#kv-about .kv-vm { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }\n#kv-about .kv-vm__card {\n  position: relative; padding: 34px 30px; border-radius: 22px; overflow: hidden;\n  border: 1px solid var(--kv-line);\n  background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));\n}\n#kv-about .kv-vm__card::before {\n  content: \"\"; position: absolute; top: 0; right: 0; width: 4px; height: 100%; background: var(--kv-accent);\n}\n#kv-about .kv-vm__card--mission::before { background: rgba(255,255,255,.35); }\n#kv-about .kv-vm__tag {\n  display: inline-block; margin-bottom: 14px; padding: 5px 14px; border-radius: 999px;\n  font-size: 12px; font-weight: 800; color: var(--kv-ink); background: var(--kv-accent);\n}\n#kv-about .kv-vm__card--mission .kv-vm__tag { color: #fff; background: rgba(255,255,255,.14); border: 1px solid var(--kv-line); }\n#kv-about .kv-vm__title { margin: 0 0 12px; font-size: clamp(18px, 2.2vw, 23px); font-weight: 800; line-height: 1.4; }\n#kv-about .kv-vm__text { margin: 0; font-size: clamp(14px, 1.5vw, 16px); line-height: 2; color: var(--kv-muted); }\n\n/* ---------- Products grid ---------- */\n#kv-about .kv-prods { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }\n#kv-about .kv-prod {\n  display: flex; flex-direction: column; align-items: flex-start;\n  padding: 26px 24px; border-radius: 18px; text-decoration: none; color: inherit;\n  border: 1px solid var(--kv-line); background: var(--kv-card);\n  transition: transform .25s var(--kv-ease), border-color .25s, box-shadow .25s, background-color .25s;\n}\n#kv-about .kv-prod:hover { transform: translateY(-4px); border-color: rgba(255,199,44,.45); background: rgba(255,199,44,.06); box-shadow: 0 18px 40px rgba(0,0,0,.35); }\n#kv-about .kv-prod:focus-visible { outline: 3px solid var(--kv-accent); outline-offset: 3px; }\n#kv-about .kv-prod__badge {\n  margin-bottom: 14px; padding: 5px 12px; border-radius: 8px;\n  font-size: 12px; font-weight: 700; color: var(--kv-accent);\n  background: rgba(255,199,44,.10); border: 1px solid rgba(255,199,44,.22);\n}\n#kv-about .kv-prod__name { margin: 0 0 8px; font-size: clamp(16px, 1.9vw, 19px); font-weight: 700; line-height: 1.5; }\n#kv-about .kv-prod__desc { margin: 0 0 18px; font-size: clamp(13px, 1.4vw, 15px); line-height: 1.85; color: var(--kv-muted); }\n#kv-about .kv-prod__more { margin-top: auto; font-size: 14px; font-weight: 700; color: var(--kv-accent); }\n#kv-about .kv-prod:hover .kv-prod__more { text-decoration: underline; }\n\n/* ---------- FAQ ---------- */\n#kv-about .kv-faq { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }\n#kv-about .kv-faq__item {\n  border: 1px solid var(--kv-line); border-radius: 14px; background: var(--kv-card);\n  padding: 4px 20px; transition: border-color .2s;\n}\n#kv-about .kv-faq__item[open] { border-color: rgba(255,199,44,.35); }\n#kv-about .kv-faq__item summary {\n  list-style: none; cursor: pointer; padding: 16px 0; position: relative;\n  font-size: clamp(15px, 1.7vw, 17px); font-weight: 700; padding-left: 34px;\n}\n#kv-about .kv-faq__item summary::-webkit-details-marker { display: none; }\n#kv-about .kv-faq__item summary::before {\n  content: \"+\"; position: absolute; left: 0; top: 50%; transform: translateY(-50%);\n  width: 24px; height: 24px; border-radius: 50%; display: inline-flex;\n  align-items: center; justify-content: center; font-size: 18px; font-weight: 700;\n  color: var(--kv-accent); background: rgba(255,199,44,.10); border: 1px solid rgba(255,199,44,.25);\n  transition: transform .25s var(--kv-ease);\n}\n#kv-about .kv-faq__item[open] summary::before { content: \"−\"; transform: translateY(-50%) rotate(180deg); }\n#kv-about .kv-faq__ans p { margin: 0 0 16px; font-size: clamp(14px, 1.5vw, 16px); line-height: 1.95; color: var(--kv-muted); }\n#kv-about .kv-faq__item summary:focus-visible { outline: 3px solid var(--kv-accent); outline-offset: 3px; border-radius: 8px; }\n\n/* ---------- Final CTA ---------- */\n#kv-about .kv-about__final { margin-top: clamp(56px, 9vw, 112px); }\n#kv-about .kv-about__final-inner {\n  position: relative; overflow: hidden; text-align: center;\n  padding: clamp(40px, 6vw, 68px) clamp(24px, 5vw, 60px); border-radius: 26px;\n  border: 1px solid rgba(255,199,44,.25);\n  background:\n    radial-gradient(100% 130% at 50% 0%, rgba(255,199,44,.16) 0%, rgba(255,199,44,0) 60%),\n    var(--kv-bg-2);\n}\n#kv-about .kv-about__final-title { margin: 0 0 12px; font-size: clamp(22px, 3.2vw, 34px); font-weight: 800; }\n#kv-about .kv-about__final-text { margin: 0 auto; max-width: 560px; font-size: clamp(14px, 1.6vw, 17px); line-height: 1.95; color: var(--kv-muted); }\n#kv-about .kv-about__final .kv-about__cta { margin-top: 26px; }\n\n/* ---------- a11y helper ---------- */\n#kv-about .kv-sr-only {\n  position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;\n  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;\n}\n\n/* ---------- Reveal animation ---------- */\n#kv-about [data-kv-reveal] { opacity: 0; transform: translateY(26px); transition: opacity .7s var(--kv-ease), transform .7s var(--kv-ease); }\n#kv-about [data-kv-reveal].is-in { opacity: 1; transform: none; }\n\n/* ---------- Responsive ---------- */\n@media (max-width: 900px) {\n  #kv-about .kv-cards, #kv-about .kv-prods { grid-template-columns: repeat(2, 1fr); }\n  #kv-about .kv-vm { grid-template-columns: 1fr; }\n  #kv-about .kv-about__stats { grid-template-columns: repeat(2, 1fr); max-width: 520px; }\n}\n@media (max-width: 620px) {\n  #kv-about .kv-cards, #kv-about .kv-prods { grid-template-columns: 1fr; }\n  #kv-about .kv-timeline::before { right: 22px; }\n  #kv-about .kv-timeline__year { width: 46px; height: 46px; font-size: 12px; }\n  #kv-about .kv-timeline__item { gap: 14px; }\n}\n@media (max-width: 440px) {\n  #kv-about .kv-about__stats { grid-template-columns: 1fr; max-width: 320px; }\n  #kv-about .kv-about__cta .kv-about__btn { flex: 1 1 auto; justify-content: center; }\n}\n@media (prefers-reduced-motion: reduce) {\n  #kv-about * { animation: none !important; }\n  #kv-about [data-kv-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }\n  #kv-about .kv-about__btn, #kv-about .kv-card, #kv-about .kv-prod { transition: none !important; }\n}\n</style>\n\n<script id=\"kv-about-script\">\n(function () {\n  'use strict';\n  var root = document.getElementById('kv-about');\n  if (!root || root.dataset.kvInit === '1') return;\n  root.dataset.kvInit = '1';\n\n  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  // ---- Persian digit helper ----\n  var FA = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n  function toFa(n) { return String(n).replace(/\\d/g, function (d) { return FA[+d]; }); }\n  function group(n) { return String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ','); }\n\n  // ---- Reveal on scroll ----\n  var revealEls = root.querySelectorAll('[data-kv-reveal]');\n  if (reduce || !('IntersectionObserver' in window)) {\n    revealEls.forEach(function (el) { el.classList.add('is-in'); });\n  } else {\n    var io = new IntersectionObserver(function (entries) {\n      entries.forEach(function (e) {\n        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }\n      });\n    }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });\n    revealEls.forEach(function (el) { io.observe(el); });\n  }\n\n  // ---- Animated counters ----\n  var counters = root.querySelectorAll('.kv-count');\n  function animateCount(el) {\n    var target = parseInt(el.getAttribute('data-to'), 10) || 0;\n    var suffix = el.getAttribute('data-suffix') || '';\n    if (reduce) { el.textContent = toFa(group(target)) + suffix; return; }\n    var start = null, dur = 1600;\n    function step(ts) {\n      if (start === null) start = ts;\n      var p = Math.min((ts - start) / dur, 1);\n      var eased = 1 - Math.pow(1 - p, 3);\n      var val = Math.round(target * eased);\n      el.textContent = toFa(group(val)) + suffix;\n      if (p < 1) requestAnimationFrame(step);\n    }\n    requestAnimationFrame(step);\n  }\n  if ('IntersectionObserver' in window) {\n    var cio = new IntersectionObserver(function (entries) {\n      entries.forEach(function (e) {\n        if (e.isIntersecting) { animateCount(e.target); cio.unobserve(e.target); }\n      });\n    }, { threshold: 0.5 });\n    counters.forEach(function (el) { cio.observe(el); });\n  } else {\n    counters.forEach(function (el) { animateCount(el); });\n  }\n})();\n</script>\n<!-- ============ END KAVERUN — معرفی گروه صنعتی کاوران ============ -->\n"},"elements":[]}],"isInner":false}],"page_settings":[],"version":"0.4","title":"درباره ما — گروه صنعتی کاوران","type":"container"}